PORT=4173

# Used by ManyChat External Request:
# POST /api/manychat-event?account=ACCOUNT_ID&key=EVENT_INGEST_KEY
EVENT_INGEST_KEY=replace-with-a-secret-key

# Optional: direct ManyChat Page API tokens for account metadata/tag lookup.
MANYCHAT_API_KEY=
MANYCHAT_API_KEY_FB1177107122151553=
MANYCHAT_API_KEY_FB701760706347255=

# Existing Google Sheet / Apps Script webhook for Order Key-In.
WEBHOOK_URL=

# Optional Dashboard Login / Logout protection.
# When AUTH_ENABLED=true and AUTH_PASSWORD or AUTH_PASSWORD_HASH is set,
# visitors must log in before opening the dashboard.
AUTH_ENABLED=false
AUTH_EMAIL=
AUTH_PASSWORD=
# Safer option: use sha256 password hash instead of plain password.
# Example value format: sha256:<64-character-hex>
AUTH_PASSWORD_HASH=
